<%@ include file="head.jspf" %>
<section class="form-layout"><div><h1>Profil saya</h1><p>Perbarui nama dan email. Peran akunmu: <strong><c:out value="${user.role}"/></strong>.</p><p>Untuk mengganti kata sandi, isi kata sandi saat ini dan kata sandi baru. Biarkan keduanya kosong jika tidak ingin menggantinya.</p></div>
<form action="${pageContext.request.contextPath}/profile" method="post" class="panel"><input type="hidden" name="csrf" value="${csrf}"><label for="name">Nama</label><input id="name" name="name" maxlength="80" autocomplete="name" required value="<c:out value='${empty param.name ? user.name : param.name}'/>"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="160" autocomplete="email" required value="<c:out value='${empty param.email ? user.email : param.email}'/>"><label for="oldPassword">Kata sandi saat ini (untuk mengganti)</label><input id="oldPassword" name="oldPassword" type="password" maxlength="128" autocomplete="current-password"><label for="newPassword">Kata sandi baru (opsional)</label><input id="newPassword" name="newPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" aria-describedby="new-password-hint"><p id="new-password-hint" class="hint">12 sampai 128 karakter. Nama dan email tetap bisa diubah tanpa mengganti kata sandi.</p><button type="submit">Simpan profil</button><p class="loading" role="status" hidden>Sedang menyimpan profil…</p></form></section>
<%@ include file="foot.jspf" %>
