<%@ include file="head.jspf" %>
<div class="page-heading"><a href="${pageContext.request.contextPath}/admin?kind=${kind}">Kembali ke daftar</a><h1>${id eq 0 ? 'Tambah' : 'Ubah'} <c:out value="${kindLabel}"/></h1></div>
<form action="${pageContext.request.contextPath}/admin/save" method="post" class="panel editor"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="kind" value="${kind}"><input type="hidden" name="id" value="${id}">
<c:choose><c:when test="${kind eq 'accounts'}">
<label for="name">Nama</label><input id="name" name="name" maxlength="80" required value="<c:out value='${account.name}'/>"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="160" required value="<c:out value='${account.email}'/>"><label for="password">Kata sandi ${id eq 0 ? '' : '(kosongkan agar tetap)'}</label><input id="password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" ${id eq 0 ? 'required' : ''} aria-describedby="password-hint"><p class="hint" id="password-hint">12 sampai 128 karakter. Kata sandi tersimpan tidak ditampilkan.</p><label for="role">Peran</label><select id="role" name="role"><option value="user" ${account.role eq 'user' ? 'selected' : ''}>User</option><option value="admin" ${account.role eq 'admin' ? 'selected' : ''}>Admin</option></select>
</c:when><c:otherwise>
<label for="title">${kind eq 'feedback' ? 'Nama' : 'Judul'}</label><input id="title" name="title" maxlength="${kind eq 'feedback' ? '80' : '160'}" required value="<c:out value='${entry.title}'/>"><label for="detail">${kind eq 'books' ? 'Deskripsi' : kind eq 'courses' ? 'Topik' : 'Masukan'}</label><textarea id="detail" name="detail" rows="6" maxlength="${kind eq 'courses' ? '500' : '2000'}" required><c:out value="${entry.detail}"/></textarea>
<c:choose><c:when test="${kind eq 'books'}"><label for="extra">Sampul</label><select id="extra" name="extra"><option value="Math.webp" ${entry.extra eq 'Math.webp' ? 'selected' : ''}>Matematika</option><option value="Science.webp" ${entry.extra eq 'Science.webp' ? 'selected' : ''}>Sains</option><option value="Physics.webp" ${entry.extra eq 'Physics.webp' ? 'selected' : ''}>Fisika</option><option value="History1.jpeg" ${entry.extra eq 'History1.jpeg' ? 'selected' : ''}>Sejarah</option></select></c:when><c:when test="${kind eq 'courses'}"><label for="extra">Tautan materi (http/https)</label><input id="extra" name="extra" type="url" maxlength="1000" required value="<c:out value='${entry.extra}'/>"></c:when><c:otherwise><label for="extra">Email</label><input id="extra" name="extra" type="email" maxlength="160" required value="<c:out value='${entry.extra}'/>"></c:otherwise></c:choose>
</c:otherwise></c:choose><button type="submit">Simpan data</button><p class="loading" role="status" hidden>Sedang menyimpan data…</p></form>
<%@ include file="foot.jspf" %>
