<%@ include file="head.jspf" %>
<div class="page-heading"><h1>Kelola data</h1><p>Tambahkan, perbarui, atau hapus isi katalog dan data akun. Perubahan tersimpan di database.</p></div>
<nav class="tabs" aria-label="Jenis data"><a href="${pageContext.request.contextPath}/admin?kind=books" aria-current="${kind eq 'books' ? 'page' : 'false'}">Buku</a><a href="${pageContext.request.contextPath}/admin?kind=courses" aria-current="${kind eq 'courses' ? 'page' : 'false'}">Course</a><a href="${pageContext.request.contextPath}/admin?kind=accounts" aria-current="${kind eq 'accounts' ? 'page' : 'false'}">Akun</a><a href="${pageContext.request.contextPath}/admin?kind=feedback" aria-current="${kind eq 'feedback' ? 'page' : 'false'}">Masukan</a></nav>
<div class="list-heading"><h2>${kind eq 'books' ? 'Buku' : kind eq 'courses' ? 'Course' : kind eq 'accounts' ? 'Akun' : 'Masukan'}</h2><a class="button" href="${pageContext.request.contextPath}/admin/edit?kind=${kind}">Tambah ${kind eq 'books' ? 'buku' : kind eq 'courses' ? 'course' : kind eq 'accounts' ? 'akun' : 'masukan'}</a></div>
<c:choose><c:when test="${kind eq 'accounts'}"><div class="admin-list"><c:forEach items="${accounts}" var="account"><article class="admin-row" data-record-id="${account.id}"><div><h3><c:out value="${account.name}"/></h3><p><c:out value="${account.email}"/> · <c:out value="${account.role}"/></p></div><div class="actions"><a href="${pageContext.request.contextPath}/admin/edit?kind=accounts&amp;id=${account.id}">Ubah<span class="sr-only"> <c:out value="${account.name}"/></span></a><a href="${pageContext.request.contextPath}/admin/remove?kind=accounts&amp;id=${account.id}">Hapus<span class="sr-only"> <c:out value="${account.name}"/></span></a></div></article></c:forEach></div></c:when>
<c:otherwise><c:if test="${empty entries}"><div class="empty"><h3>Belum ada data</h3><p>Gunakan tombol Tambah untuk membuat entri pertama.</p></div></c:if><div class="admin-list"><c:forEach items="${entries}" var="entry"><article class="admin-row" data-record-id="${entry.id}"><div><h3><c:out value="${entry.title}"/></h3><p><c:out value="${entry.detail}"/></p><c:if test="${kind eq 'feedback'}"><p class="hint"><c:out value="${entry.extra}"/></p></c:if></div><div class="actions"><a href="${pageContext.request.contextPath}/admin/edit?kind=${kind}&amp;id=${entry.id}">Ubah<span class="sr-only"> <c:out value="${entry.title}"/></span></a><a href="${pageContext.request.contextPath}/admin/remove?kind=${kind}&amp;id=${entry.id}">Hapus<span class="sr-only"> <c:out value="${entry.title}"/></span></a></div></article></c:forEach></div></c:otherwise></c:choose>
<%@ include file="foot.jspf" %>
