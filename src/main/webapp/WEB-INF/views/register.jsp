<%@ include file="head.jspf" %>
<section class="form-layout"><div><h1>Buat ruang belajarmu.</h1><p>Akun member membuka daftar course dan halaman profil. Pendaftaran ini gratis, tanpa pembayaran.</p><p>Sudah punya akun? <a href="${pageContext.request.contextPath}/login">Masuk ke Hololearn</a>.</p><p>Ini aplikasi demo lokal. Gunakan data contoh. <a href="${pageContext.request.contextPath}/about">Baca penggunaan data</a>.</p></div>
<form action="${pageContext.request.contextPath}/register" method="post" class="panel"><input type="hidden" name="csrf" value="${csrf}"><label for="name">Nama</label><input id="name" name="name" maxlength="80" autocomplete="name" required value="<c:out value='${param.name}'/>"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="160" autocomplete="email" required value="<c:out value='${param.email}'/>"><label for="password">Kata sandi</label><input id="password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" aria-describedby="password-hint" required><p id="password-hint" class="hint">Gunakan 12 sampai 128 karakter.</p><button type="submit">Buat akun</button><p class="loading" role="status" hidden>Sedang membuat akun…</p></form></section>
<%@ include file="foot.jspf" %>
